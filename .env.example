# Kopiraj u .env.local.
# Lokalno: vrednosti ispisuje `supabase start`.
# Na Supabase-u u oblaku: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google prijava. Lokalni Supabase nema podešen Google provajder, pa dugme
# vodi na sirovu grešku — zato je ovde isključeno. U produkciji izostavi ovaj
# red (podrazumevano je uključeno) ili stavi `true`.
NEXT_PUBLIC_GOOGLE_SIGN_IN=false
