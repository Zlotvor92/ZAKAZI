# Kopiraj u .env.local.
# Lokalno: vrednosti ispisuje `supabase start`.
# Na Supabase-u u oblaku: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google prijava. Lokalni Supabase nema podešen Google provajder, pa dugme
# vodi na sirovu grešku — zato je ovde isključeno. U produkciji izostavi ovaj
# red (podrazumevano je uključeno) ili stavi `true`.
NEXT_PUBLIC_GOOGLE_SIGN_IN=false

# Ključ koji zaobilazi RLS. Samo na serveru, nikad sa `NEXT_PUBLIC_` prefiksom.
# Bez njega ne rade obaveštenja o zakazivanju ni pravljenje salona iz konzole.
# Lokalno ga ispisuje `supabase start`; u oblaku je Project Settings → API.
SUPABASE_SERVICE_ROLE_KEY=

# Obaveštenja na telefon. Bez ovih tri se prosto ne uključuju.
# Par ključeva: `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ime@primer.rs
